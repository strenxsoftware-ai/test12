
{
  "entities": {
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "A fashion item in the Viloryi catalog.",
      "properties": {
        "id": { "type": "string", "description": "Unique product identifier." },
        "name": { "type": "string", "description": "Display name of the product." },
        "price": { "type": "number", "description": "Legacy price field (deprecated in favor of originalPrice)." },
        "originalPrice": { "type": "number", "description": "The base price of the item before any discounts." },
        "discountPrice": { "type": "number", "description": "The final selling price after discount. If null, originalPrice is used." },
        "category": { 
          "type": "string",
          "description": "The ID of the category this product belongs to." 
        },
        "images": { 
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "description": "Array of image URLs."
        },
        "description": { "type": "string", "description": "Marketing description." },
        "materials": { "type": "string", "description": "Fabric composition." },
        "details": { "type": "string", "description": "Styling details." },
        "sizes": { 
          "type": "array",
          "items": { "type": "string", "enum": ["XS", "S", "M", "L", "XL", "XXL"] },
          "description": "Available sizes."
        },
        "stock": { "type": "number", "description": "Inventory count." },
        "createdAt": { "type": "string", "format": "date-time" },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["id", "name", "originalPrice", "category", "images", "description"]
    },
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "mobile": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "influencer"], "default": "user" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "affiliateId": { "type": "string", "description": "Unique ID used for referral links." },
        "referralUsername": { "type": "string", "description": "Branded handle for influencer profile (e.g., prince)" },
        "referralBio": { "type": "string", "description": "Short bio for the branded landing page" },
        "referralDisplayName": { "type": "string", "description": "Name shown on the landing page" },
        "totalEarnings": { "type": "number", "description": "Aggregated brand credits earned." }
      }
    },
    "ReferralLink": {
      "title": "Referral Link",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "targetName": { "type": "string", "description": "Product or Category name linked to" },
        "type": { "type": "string", "enum": ["product", "category", "profile"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Commission": {
      "title": "Affiliate Commission",
      "type": "object",
      "properties": {
        "influencerId": { "type": "string" },
        "orderId": { "type": "string" },
        "amount": { "type": "number", "description": "Amount credited to influencer (12% of order total)." },
        "orderTotal": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "earned"], "default": "earned" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Address": {
      "title": "Address",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "pincode": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "houseNo": { "type": "string" },
        "building": { "type": "string" },
        "locality": { "type": "string" },
        "type": { "type": "string", "enum": ["home", "office"] },
        "isDefault": { "type": "boolean" }
      }
    },
    "Collaboration": {
      "title": "Collaboration Request",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "instagram": { "type": "string" },
        "followers": { "type": "string" },
        "message": { "type": "string" },
        "consent": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "default": "pending" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "phone", "consent"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "Public product catalog."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Private user profiles and preferences."
    },
    "/users/{userId}/links/{linkId}": {
      "schema": { "$ref": "#/backend/entities/ReferralLink" },
      "description": "Influencer's generated branded links."
    },
    "/commissions/{commissionId}": {
      "schema": { "$ref": "#/backend/entities/Commission" },
      "description": "Earnings generated via affiliate links."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/backend/entities/Address" },
      "description": "User's saved shipping addresses."
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "User's private wishlist of saved products."
    },
    "/collaboration/{collaborationId}": {
      "schema": { "$ref": "#/backend/entities/Collaboration" },
      "description": "Influencer collaboration submissions."
    }
  }
}
