
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /commissions/{commId} {
      // Allow any buyer to create a commission record on successful purchase
      allow create: if isSignedIn();
      // Only the influencer can read their own commissions
      allow read: if isSignedIn() && request.auth.uid == resource.data.influencerId;
    }

    match /collaboration/{collabId} {
      allow create: if true;
      // Rule-as-filter for influencer dashboard history (if needed)
      allow read: if isSignedIn() && (resource.data.email == request.auth.token.email);
      allow update, delete: if false;
    }

    match /users/{userId} {
      // Allow public read for influencer landing pages and username uniqueness checks
      allow get, list: if true;
      
      // Still restrict writes to the owner
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /{allSubcollections=**} {
        // Protect private subcollections (addresses, links, wishlist)
        allow read, write: if isOwner(userId);
      }
    }
  }
}
